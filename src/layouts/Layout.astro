---
import '../styles/global.css';
interface Props { title?: string; description?: string; wide?: boolean }
const { title = 'Exam Countdown', description = 'Your next exam, on your lock screen. Paste your schedule, get a wallpaper that counts down the days, updated automatically every morning.', wide = false } = Astro.props;
const container = wide ? 'max-w-6xl' : 'max-w-3xl';
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
---
<!doctype html>
<html lang="en" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#000000" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Exam Countdown" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="A phone lock screen showing a 9-day countdown to an exam, with a small line-art character screaming." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:creator" content="@isaacdnigerian" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body class="min-h-full antialiased">
    <main class:list={["mx-auto px-4 py-14 sm:py-20", container]}>
      <slot />
    </main>
    <footer class:list={["mx-auto mt-16 flex flex-wrap items-center justify-between gap-x-8 gap-y-3 border-t border-line px-4 pt-8 pb-12 text-xs text-dim", container]}>
      <p>Made by <a href="https://x.com/isaacdnigerian" target="_blank" rel="noopener me" class="text-muted underline underline-offset-2 hover:text-white">@isaacdnigerian</a></p>
      <p class="flex flex-wrap gap-x-4">
        <span>Built with <a href="https://claude.ai" target="_blank" rel="noopener" class="underline underline-offset-2 hover:text-muted">Claude</a>, <a href="https://claude.com/claude-code" target="_blank" rel="noopener" class="underline underline-offset-2 hover:text-muted">Claude Code</a> and <a href="https://gemini.google.com" target="_blank" rel="noopener" class="underline underline-offset-2 hover:text-muted">Google Gemini</a></span>
        <a href="/stats" class="underline underline-offset-2 hover:text-muted">Usage</a>
      </p>
    </footer>
  </body>
</html>
